# Rajdhani Tea Platform — repository-wide ignores.
#
# backend/api/, frontend/customer/ and frontend/admin/ each keep their own
# .gitignore for things specific to that stack. This file covers what is true
# everywhere, and deliberately repeats the few rules that must not depend on a
# sub-directory file still being there — a secret committed once is in the
# history for good, even if it is deleted in the next commit.


# ─── Secrets ─────────────────────────────────────────────────────────────────
# Doc §15. Real values never leave the machine they belong to; .env.example is
# the committed record of which variables exist.
#
# Note for the front-ends: Vite's default .gitignore covers `.env.local` and
# `*.local` but NOT a plain `.env`, and Vite inlines VITE_* values into the
# build. The rule below is what actually stops a frontend .env being committed.
.env
.env.*
!.env.example
!.env.*.example

# Credentials and certificates, whatever they are called.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
service-account*.json
google-credentials*.json
credentials.json
secrets.json
*.crt
!**/ca-bundle.crt


# ─── Dependencies ────────────────────────────────────────────────────────────
# Installed from the lock files, which ARE committed.
node_modules/
vendor/
.pnp
.pnp.js


# ─── Build output ────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
.vite/
*.local

# Not `public/` — both front-ends keep static assets there, and the backend's
# public/ holds index.php and .htaccess. All of it is source.


# ─── Database dumps and backups ──────────────────────────────────────────────
# Careful: no blanket `*.sql`. backend/api/database/migrations/*.sql is the
# schema and must be committed; so is database/seed-data/. Only dumps are
# excluded, and they are excluded because a production dump contains customer
# personal data (doc §14.1) as well as being large.
*.sql.gz
*.sql.zip
*.dump
*.mwb.bak
/backups/
**/backups/
dump.rdb


# ─── Runtime writables ───────────────────────────────────────────────────────
# Generated by the running application; the directories are kept, the contents
# are not.
backend/api/storage/logs/*
!backend/api/storage/logs/.gitkeep
backend/api/storage/cache/*
!backend/api/storage/cache/.gitkeep
backend/api/public/uploads/*
!backend/api/public/uploads/.gitkeep


# ─── Logs ────────────────────────────────────────────────────────────────────
# Anchored to the repository root on purpose. An unanchored `logs/` matches
# backend/api/storage/logs/ as well — and once git excludes a directory it does
# not descend into it, so the `!.gitkeep` negation above would never be reached
# and the directory would vanish from a fresh clone.
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ─── Tool caches and coverage ────────────────────────────────────────────────
.php-cs-fixer.cache
.phpunit.cache/
.phpunit.result.cache
.phpstan.cache/
coverage/
.nyc_output/
*.lcov
.eslintcache


# ─── Editors ─────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.sublime-workspace
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln


# ─── Operating system ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# ─── Local scratch ───────────────────────────────────────────────────────────
# Anything you want kept out of the repository without editing this file.
/tmp/
/scratch/
*.tmp
*.bak
*.orig
*.rej
